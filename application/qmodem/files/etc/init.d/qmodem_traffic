#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=1

start_service()
{
    procd_open_instance traffic
    procd_set_param command /bin/sh /usr/share/qmodem/traffic.sh loop
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 20
    procd_set_param stderr 1
    procd_close_instance
}
