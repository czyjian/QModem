#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /etc/qmodem-unicom
	chown nobody:nogroup /etc/qmodem-unicom
	chmod 700 /etc/qmodem-unicom
	procd_open_instance
	procd_set_param command /usr/bin/node /usr/share/qmodem-unicom/server/src/server.js
	procd_set_param env HOST=127.0.0.1 PORT=8788 LOG_LEVEL=warn DEBUG_RAW=false SESSION_STORE=/etc/qmodem-unicom/sessions.json
	procd_set_param user nobody
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
